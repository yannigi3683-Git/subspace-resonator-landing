# Restreamer config. Copy to .env (gitignored). All values sanitized to printable ASCII at load.

# ffmpeg binary (omit to use PATH).
FFMPEG_PATH=

# Supabase (staging first, prod at cutover). SECRET key writes live_session.streamUrl.
SUPABASE_URL=https://<project-id>.supabase.co
SUPABASE_SECRET_KEY=sb_secret_<...>
# Publishable key: the restreamer signs in anonymously with this to pull like a listener.
SUPABASE_PUBLISHABLE_KEY=sb_publishable_<...>

# The app broker that brokers the SFU pull (a deployed /api/rtc-session).
BROKER_URL=https://<preview-or-prod-host>/api/rtc-session

# Output sink: 'local' (serve over HTTP, dev) or 'r2' (Cloudflare R2, prod).
SINK=local
LOCAL_PORT=8788
# Base URL listeners fetch from. Local: leave blank (defaults to http://127.0.0.1:LOCAL_PORT).
# R2: the bucket's public CDN base, e.g. https://radio-hls.subspaceresonator.com
PUBLIC_BASE_URL=

# R2 (only when SINK=r2).
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# HLS shape (defaults are fine).
SEGMENT_SECONDS=6
HLS_WINDOW=8
# Delivered audio bitrate. 192k = near-transparent; set 128k if r2.dev bandwidth gets tight.
AAC_BITRATE=192k
